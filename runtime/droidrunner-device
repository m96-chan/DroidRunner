#!/usr/bin/env bash
#
# droidrunner-device — talk to the DroidRunner Device Agent from a CI job.
#
# The agent runs in the Android app and exposes hardware (NNAPI, and Qualcomm's
# own runtime) that a process inside the PRoot guest cannot reach. The runner
# injects DROIDRUNNER_DEVICE_URL and DROIDRUNNER_DEVICE_TOKEN; this wrapper
# hides the HTTP/token plumbing.
#
# Usage:
#   droidrunner-device capabilities
#   droidrunner-device devices [--all] [--json]
#   droidrunner-device test add  [--device NAME] [--iterations N]
#   droidrunner-device test conv [--device NAME] [--iterations N]
#                                [--size N] [--channels N] [--filters N]
#   droidrunner-device test model <file.tflite> [--device NAME] [--iterations N]
#                                              [--feature NAME]
#                                   [--input FILE]... [--output-dir DIR] [--baseline]
#                                   [--timings] [--delegate-log]
#   droidrunner-device test batch <manifest.json> [--budget-ms N]
#   droidrunner-device bench-all [--iterations N] [--size N] [--json]
#
# Everywhere: --output FILE writes the machine-readable result to FILE as well
# as stdout, so a job can hand it to upload-artifact without a redirect that
# also catches a warning line.
#
# N above is digits and nothing else, and NAME is letters, digits and . _ + - .
# Both are checked before the request is built, and anything else is refused by
# name rather than spliced into the JSON body.
#
# Exit status (see docs/RESULT-CONTRACT.md):
#   0  it ran
#   1  usage error, an option value that cannot go in a request, or something
#      unclassified
#   2  the driver refused the graph — a sweep records this and carries on
#   3  no such device on this phone
#   4  the agent is unreachable — a sweep stops
#   5  the phone is busy and attempted nothing — wait and send the same
#      request again; the refusal says how long
#
# An HTTP error from the agent — a capability token that rotated, a URL it does
# not route — is reported with its status and exits non-zero. It is never
# printed as a result, because a caller reading `devices` cannot tell an error
# envelope from a phone with no accelerators.
set -euo pipefail

# Human notes go to stderr throughout, so stdout is only ever the result. A
# consumer pipes stdout into jq; a person reads both interleaved as before.
note() { echo "$*" >&2; }
die() { note "droidrunner-device: $*"; exit 1; }

EXIT_REFUSED=2
EXIT_UNKNOWN_DEVICE=3
EXIT_UNREACHABLE=4
# The phone answered, and is busy. Its own status because the answer is the
# opposite of every other failure here: nothing was attempted and the same
# request will work later. It used to arrive as 1 — the one status a caller
# must never retry on, since it means the request itself was wrong (#233).
EXIT_BUSY=5

[ -n "${DROIDRUNNER_DEVICE_URL:-}" ] || {
    note "droidrunner-device: DROIDRUNNER_DEVICE_URL is not set (is this job running on a DroidRunner device?)"
    exit $EXIT_UNREACHABLE
}
command -v curl >/dev/null || die "curl is required"

# The capability token is issued per job and delivered through a file in the
# app-private runtime directory, so it never sits in the environment (where it
# would outlive the job and show up in process listings).
if [ -z "${DROIDRUNNER_DEVICE_TOKEN:-}" ]; then
    token_file="${DROIDRUNNER_DEVICE_TOKEN_FILE:-/home/runner/.droidrunner-agent-token}"
    [ -r "$token_file" ] || die "no capability token at $token_file (the agent only issues one while a job runs)"
    DROIDRUNNER_DEVICE_TOKEN="$(cat "$token_file")"
fi

output_file=""

# The curl arguments for one request, in a global because a function cannot
# return an array. One builder and not two: ask() below sends the same request a
# second time to recover the body -f hides, and that second copy had drifted
# into a hard-coded POST — so a GET was retried as a POST, the agent answered
# 404 "unknown endpoint" with curl exiting 0, and the error envelope came back
# as the payload (#205).
curl_args() {  # curl_args <method> <path> [data] -> CURL_ARGS
    local method="$1" path="$2" data="${3:-}"
    CURL_ARGS=(-sS -H "Authorization: Bearer $DROIDRUNNER_DEVICE_TOKEN")
    if [ "$method" != "GET" ]; then
        CURL_ARGS+=(-X POST -H "Content-Type: application/json" -d "$data")
    fi
    CURL_ARGS+=("$DROIDRUNNER_DEVICE_URL$path")
}

api() {  # api <method> <path> [data]
    curl_args "$@"
    curl -f "${CURL_ARGS[@]}"
}

# The same request without -f, with the HTTP status on a line of its own after
# the body. curl exits 0 for a 401 as readily as for a 200, so the status is the
# only thing that tells a recovered error apart from a payload.
api_with_status() {  # api_with_status <method> <path> [data]
    curl_args "$@"
    curl -w '\n%{http_code}' "${CURL_ARGS[@]}"
}

# Whether a recovered error body is still an answer to the question asked.
#
# A POST that reached a test endpoint gets the contract's own code and message
# back under HTTP 400 — unknown-device, inputs that do not fit the model — and
# that body is the result the caller emits and --output keeps, so it travels on.
# A 401 or 403 is about the token and a 404 is about the URL: neither has a
# result in it. A GET is that story whatever the status, because `capabilities`
# and `devices` read the payload by its shape, and an error envelope reads to
# them as a phone with no accelerators (#205).
answers_the_request() {  # answers_the_request <method> <http status>
    case "$1" in GET) return 1 ;; esac
    # 503 joins them: the agent refused the connection before reading the
    # request, so the body describes the phone and not the model (#233).
    case "$2" in 401|403|404|503) return 1 ;; esac
    return 0
}

# Like api(), but tells a refusal apart from a phone that stopped answering:
# curl fails for both a 4xx and a dead socket, and only one of those is worth
# abandoning a sweep over.
ask() {
    local body status recovered http exit_code
    set +e
    body="$(api "$@" 2>/dev/null)"
    status=$?
    set -e
    if [ $status -ne 0 ] && [ -z "$body" ]; then
        # -f swallows the body on an HTTP error, so ask again without it before
        # concluding the agent is gone — with the method the caller asked for,
        # and a body only when that method is POST.
        set +e
        recovered="$(api_with_status "$@" 2>/dev/null)"
        status=$?
        set -e
        # The status is the last line; the body is everything before it.
        http="${recovered##*$'\n'}"
        body="${recovered%$'\n'*}"
        if [ $status -ne 0 ] || [ -z "$recovered" ] || [ "$http" = "000" ]; then
            note "droidrunner-device: the agent at $DROIDRUNNER_DEVICE_URL did not answer"
            exit $EXIT_UNREACHABLE
        fi
        if ! answers_the_request "$1" "$http"; then
            # With the status, because "unknown endpoint" on its own sends a
            # reader to the URL when the fault is a token that rotated. And to
            # stderr, because it is not a result: `devices --json` printed
            # {"ok":true,"devices":[]} here and exited 0, which is a statement
            # about somebody's silicon published from an authentication failure.
            note "droidrunner-device: the agent answered HTTP $http: ${body:-(no body)}"
            exit_code=1   # an envelope with no code we know is still an error
            status_for "$body" || exit_code=$?
            exit $exit_code
        fi
    fi
    printf '%s' "$body"
}

emit() {  # emit <json>
    printf '%s\n' "$1"
    [ -n "$output_file" ] && printf '%s\n' "$1" > "$output_file"
    return 0
}

json_field() {  # json_field <json> <key>
    printf '%s' "$1" | grep -o "\"$2\":[^,}]*" | head -n1 | cut -d: -f2- | tr -d '" '
}

# Device names from the capabilities payload, without needing jq.
device_names() {
    # Fetched first, filtered second, and both halves matter.
    #
    # `ask` rather than `api`, because `ask` is what turns an unreachable agent
    # into EXIT_UNREACHABLE. And on its own line, because in a pipeline grep's
    # "no match" exits 1 and pipefail reports that instead — so a phone that
    # never answered came back as exit 1 rather than 4 (#171).
    #
    # `|| true` on the filter keeps a genuinely empty list a success: a phone
    # that answers and exposes no NNAPI driver is a fact, not a failure.
    local payload
    # `|| return $?` and not `set -e`. Measured: inside a function called from a
    # command substitution, a failing assignment does not stop the function —
    # it carried on and the caller saw success. The status has to be tested to
    # travel.
    payload="$(ask GET /v1/capabilities)" || return $?
    # `|| true` only on the filter: a phone that answers and exposes no NNAPI
    # driver is a fact, and grep's "no match" must not read as a dead agent.
    printf '%s' "$payload" | grep -o '"name":"[^"]*"' | cut -d'"' -f4 || true
}

# Every value --device accepts, which is a superset of the NNAPI drivers above:
# `gpu` is TFLite's own delegate and `qnn-*` is Qualcomm's runtime, and neither
# is an NNAPI driver. Enumerating accelerators from `devices` alone misses the
# GPU, which on a Snapdragon is the only one NNAPI cannot reach (#158).
accepted_names() {
    local payload
    payload="$(ask GET /v1/capabilities)" || return $?
    printf '%s' "$payload" \
        | grep -o '"accepts":\[[^]]*\]' \
        | sed 's/^"accepts":\[//; s/\]$//' \
        | tr ',' '\n' | tr -d '"' | grep -v '^$' || true
}

# Turns the agent's own code into this wrapper's exit status, so a caller can
# branch without parsing anything.
status_for() {  # status_for <json>
    case "$(json_field "$1" code)" in
        refused) return $EXIT_REFUSED ;;
        unknown-device|not-installed) return $EXIT_UNKNOWN_DEVICE ;;
        busy) return $EXIT_BUSY ;;
        "") return 0 ;;
        *) return 1 ;;
    esac
}

# The request body below is built by concatenation, so an option value carrying
# a comma or a quote writes fields of its own: `--iterations '1,"device":"qnn-htp"'`
# moved a benchmark onto the Hexagon while the caller read the numbers as the
# default driver's, and actions/run-model forwards that input verbatim from a
# consumer's workflow_dispatch (#206).
#
# Checked rather than escaped, because every value these options accept is this
# narrow — and a value refused by name is better than a request that quietly
# means something else. `invalid-request`, which docs/RESULT-CONTRACT.md
# publishes as exit 1.
#
# [[ =~ ]] and not a pipe into grep: grep matches a line at a time, so a value
# carrying a newline would pass on the strength of its first one.
numeric_option() {  # numeric_option <option> <value>
    [[ "$2" =~ ^[0-9]+$ ]] || \
        die "invalid-request: $1 takes a whole number, not: $2"
}

name_option() {  # name_option <option> <value>
    [[ "$2" =~ ^[A-Za-z0-9._+-]+$ ]] || \
        die "invalid-request: $1 takes a name of letters, digits and . _ + - , not: $2"
}

cmd="${1:-}"
[ -n "$cmd" ] || { sed -n '3,44p' "$0" | sed 's/^# \{0,1\}//' >&2; exit 1; }
shift || true

case "$cmd" in
    capabilities)
        # The usage above says --output works everywhere, and for a while this
        # command silently ignored it: the option was accepted and dropped, so
        # a job asking for a file got no file and no error (#125).
        while [ $# -gt 0 ]; do
            case "$1" in
                --output) output_file="$2"; shift 2 ;;
                --json) shift ;;   # already the only thing on stdout
                *) die "unknown option: $1" ;;
            esac
        done
        # Assigned, not inlined. `ask` exits on an unreachable agent, but an
        # `exit` inside $( ) ends only the subshell — so as an argument to
        # `emit` the failure was replaced by emit's own success and the step
        # passed having fetched nothing (#171).
        response="$(ask GET /v1/capabilities)" || exit $?
        emit "$response"
        ;;

    devices)
        as_json=""
        list=device_names
        while [ $# -gt 0 ]; do
            case "$1" in
                --json) as_json=1; shift ;;
                # Default stays the NNAPI drivers, because that is what this
                # has always printed and a consumer parsing it should not have
                # the meaning change underneath them.
                --all) list=accepted_names; shift ;;
                --output) output_file="$2"; shift 2 ;;
                *) die "unknown option: $1" ;;
            esac
        done
        # Same reason as capabilities above, and worse here: the JSON form
        # answered `{"ok":true,"devices":[]}` to a dead agent, which reads as
        # "this phone has no accelerators" rather than "nobody asked it".
        listed="$($list)" || exit $?
        if [ -n "$as_json" ]; then
            names=""
            for dev in $listed; do names="$names\"$dev\","; done
            emit "{\"schema\":1,\"ok\":true,\"devices\":[${names%,}]}"
        else
            # Through emit, so --output catches this form too rather than only
            # the JSON one.
            emit "$listed"
        fi
        ;;

    test)
        kind="${1:-}"; shift || true
        [ -n "$kind" ] || die "usage: droidrunner-device test add|conv|model|batch [options]"

        # A whole sweep in one request: a few hundred single-op models cost a
        # few hundred workflow steps otherwise, which is the expensive part.
        if [ "$kind" = "batch" ]; then
            manifest="${1:-}"; shift || true
            [ -n "$manifest" ] || die "usage: droidrunner-device test batch <manifest.json>"
            [ -r "$manifest" ] || die "cannot read $manifest"
            budget=""
            while [ $# -gt 0 ]; do
                case "$1" in
                    --budget-ms) numeric_option --budget-ms "$2"; budget="$2"; shift 2 ;;
                    --output) output_file="$2"; shift 2 ;;
                    --json) shift ;;
                    *) die "unknown option: $1" ;;
                esac
            done
            models="$(tr -d '\n' < "$manifest")"
            case "$models" in
                \[*) models="{\"models\":$models" ;;   # a bare array is the natural manifest
                *) die "$manifest must be a JSON array of model entries" ;;
            esac
            [ -n "$budget" ] && models="$models,\"budgetMs\":$budget"
            response="$(ask POST /v1/tests/models "$models}")" || exit $?
            emit "$response"
            exit 0
        fi

        model=""; inputs=""; output_dir=""; baseline=""
        if [ "$kind" = "model" ]; then
            model="${1:-}"; shift || true
            [ -n "$model" ] || die "usage: droidrunner-device test model <file.tflite> [options]"
            [ -r "$model" ] || die "cannot read $model"
            # The agent needs the path as the job sees it, absolute.
            model="$(cd "$(dirname "$model")" && pwd)/$(basename "$model")"
        fi
        device=""; iterations=""; size=""; channels=""; filters=""; timings=""; delegate_log=""
        features=""
        while [ $# -gt 0 ]; do
            case "$1" in
                --device) name_option --device "$2"; device="$2"; shift 2 ;;
                # Repeatable. Names an experiment the agent will otherwise
                # refuse, so that everything unasked-for keeps behaving as it
                # did — `--device a+b` without `--feature multi-delegate` is
                # not a device name, it is an unknown one (#159).
                --feature)
                    name_option --feature "$2"
                    features="$features\"$2\","; shift 2 ;;
                # Repeatable, one per input tensor, in the model's own order.
                --input)
                    [ -r "$2" ] || die "cannot read $2"
                    inputs="$inputs\"$(cd "$(dirname "$2")" && pwd)/$(basename "$2")\","
                    shift 2 ;;
                # Runs the CPU reference in the same request, so the ratio
                # comes from one thermal state rather than two steps apart.
                --baseline) baseline=1; shift ;;
                # Every iteration in run order, for seeing a throttle develop
                # rather than inferring one from the percentiles (#98).
                --timings) timings=1; shift ;;
                # What the delegate printed, unparsed. Our reading of it is a
                # regex over prose; this is the prose (#128).
                --delegate-log) delegate_log=1; shift ;;
                --output-dir)
                    mkdir -p "$2" || die "cannot create $2"
                    output_dir="$(cd "$2" && pwd)"
                    shift 2 ;;
                --output) output_file="$2"; shift 2 ;;
                --json) shift ;;   # already the only thing on stdout
                --iterations) numeric_option --iterations "$2"; iterations="$2"; shift 2 ;;
                --size) numeric_option --size "$2"; size="$2"; shift 2 ;;
                --channels) numeric_option --channels "$2"; channels="$2"; shift 2 ;;
                --filters) numeric_option --filters "$2"; filters="$2"; shift 2 ;;
                *) die "unknown option: $1" ;;
            esac
        done
        body="{"
        [ -n "$model" ] && body="$body\"path\":\"$model\","
        [ -n "$inputs" ] && body="$body\"inputs\":[${inputs%,}],"
        [ -n "$output_dir" ] && body="$body\"outputDir\":\"$output_dir\","
        [ -n "$baseline" ] && body="$body\"baseline\":true,"
        [ -n "$timings" ] && body="$body\"timings\":true,"
        [ -n "$delegate_log" ] && body="$body\"delegateLog\":true,"
        [ -n "$device" ] && body="$body\"device\":\"$device\","
        [ -n "$features" ] && body="$body\"features\":[${features%,}],"
        [ -n "$iterations" ] && body="$body\"iterations\":$iterations,"
        [ -n "$size" ] && body="$body\"size\":$size,"
        [ -n "$channels" ] && body="$body\"channels\":$channels,"
        [ -n "$filters" ] && body="$body\"filters\":$filters,"
        body="${body%,}}"
        case "$kind" in
            add) response="$(ask POST /v1/tests/nnapi "$body")" ;;
            conv) response="$(ask POST /v1/tests/conv "$body")" ;;
            model) response="$(ask POST /v1/tests/model "$body")" ;;
            *) die "unknown test: $kind (expected add, conv or model)" ;;
        esac
        emit "$response"
        # A test the device refused is a failed test. curl succeeded, so
        # without this the step passes while the phone is saying it could not
        # run the thing being asked about (issue #82).
        [ "$(json_field "$response" ok)" = "true" ] || status_for "$response" || exit $?
        ;;

    bench-all)
        iterations=50; size=64; as_json=""
        while [ $# -gt 0 ]; do
            case "$1" in
                --iterations) numeric_option --iterations "$2"; iterations="$2"; shift 2 ;;
                --size) numeric_option --size "$2"; size="$2"; shift 2 ;;
                --json) as_json=1; shift ;;
                --output) output_file="$2"; shift 2 ;;
                *) die "unknown option: $1" ;;
            esac
        done
        [ -n "$as_json" ] || printf '%-22s %12s %10s %s\n' DEVICE AVG_US GFLOPS NOTE
        entries=""
        benched="$(device_names)" || exit $?
        for dev in $benched; do
            result="$(ask POST /v1/tests/conv \
                "{\"device\":\"$dev\",\"iterations\":$iterations,\"size\":$size}")"
            entries="$entries$result,"
            [ -n "$as_json" ] && continue
            if printf '%s' "$result" | grep -q '"ok":true'; then
                printf '%-22s %12s %10s\n' "$dev" \
                    "$(json_field "$result" avgUs)" "$(json_field "$result" gflops)"
            else
                printf '%-22s %12s %10s %s\n' "$dev" "-" \
                    "$(json_field "$result" error)" "$(json_field "$result" result)"
            fi
        done
        # An array, the same shape a batch request will return, so a consumer
        # written against one reads the other (issue #94).
        #
        # An `if`, not `[ ... ] && emit`: this is the last command the script
        # runs, so with no --json the failing test became the script's exit
        # status and a successful sweep reported failure. It printed the table,
        # then exited 1.
        if [ -n "$as_json" ]; then
            emit "{\"schema\":1,\"ok\":true,\"results\":[${entries%,}]}"
        fi
        ;;

    *)
        die "unknown command: $cmd"
        ;;
esac
