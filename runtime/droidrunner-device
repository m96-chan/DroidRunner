#!/usr/bin/env bash
#
# droidrunner-device — talk to the DroidRunner Device Agent from a CI job.
#
# The agent runs in the Android app and exposes hardware (NNAPI today) that a
# process inside the PRoot guest cannot reach. The runner injects
# DROIDRUNNER_DEVICE_URL and DROIDRUNNER_DEVICE_TOKEN; this wrapper hides the
# HTTP/token plumbing.
#
# Usage:
#   droidrunner-device capabilities
#   droidrunner-device devices
#   droidrunner-device test add  [--device NAME] [--iterations N]
#   droidrunner-device test conv [--device NAME] [--iterations N]
#                                [--size N] [--channels N] [--filters N]
#   droidrunner-device test model <file.tflite> [--device NAME] [--iterations N]
#                                   [--input FILE]... [--output-dir DIR] [--baseline]
#   droidrunner-device bench-all [--iterations N] [--size N]
set -euo pipefail

die() { echo "droidrunner-device: $*" >&2; exit 1; }

[ -n "${DROIDRUNNER_DEVICE_URL:-}" ] || die "DROIDRUNNER_DEVICE_URL is not set (is this job running on a DroidRunner device?)"
command -v curl >/dev/null || die "curl is required"

# The capability token is issued per job and delivered through a file in the
# app-private runtime directory, so it never sits in the environment (where it
# would outlive the job and show up in process listings).
if [ -z "${DROIDRUNNER_DEVICE_TOKEN:-}" ]; then
    token_file="${DROIDRUNNER_DEVICE_TOKEN_FILE:-/home/runner/.droidrunner-agent-token}"
    [ -r "$token_file" ] || die "no capability token at $token_file (the agent only issues one while a job runs)"
    DROIDRUNNER_DEVICE_TOKEN="$(cat "$token_file")"
fi

api() {
    local method="$1" path="$2" data="${3:-}"
    if [ "$method" = "GET" ]; then
        curl -fsS -H "Authorization: Bearer $DROIDRUNNER_DEVICE_TOKEN" \
            "$DROIDRUNNER_DEVICE_URL$path"
    else
        curl -fsS -X POST -H "Authorization: Bearer $DROIDRUNNER_DEVICE_TOKEN" \
            -H "Content-Type: application/json" -d "$data" \
            "$DROIDRUNNER_DEVICE_URL$path"
    fi
}

# Device names from the capabilities payload, without needing jq.
device_names() {
    api GET /v1/capabilities | grep -o '"name":"[^"]*"' | cut -d'"' -f4
}

json_field() {  # json_field <json> <key>
    printf '%s' "$1" | grep -o "\"$2\":[^,}]*" | head -n1 | cut -d: -f2- | tr -d '" '
}

cmd="${1:-}"
[ -n "$cmd" ] || { sed -n '3,20p' "$0" | sed 's/^# \{0,1\}//'; exit 1; }
shift || true

case "$cmd" in
    capabilities)
        api GET /v1/capabilities
        echo
        ;;

    devices)
        device_names
        ;;

    test)
        kind="${1:-}"; shift || true
        [ -n "$kind" ] || die "usage: droidrunner-device test add|conv|model [options]"
        model=""; inputs=""; output_dir=""; baseline=""
        if [ "$kind" = "model" ]; then
            model="${1:-}"; shift || true
            [ -n "$model" ] || die "usage: droidrunner-device test model <file.tflite> [options]"
            [ -r "$model" ] || die "cannot read $model"
            # The agent needs the path as the job sees it, absolute.
            model="$(cd "$(dirname "$model")" && pwd)/$(basename "$model")"
        fi
        device=""; iterations=""; size=""; channels=""; filters=""
        while [ $# -gt 0 ]; do
            case "$1" in
                --device) device="$2"; shift 2 ;;
                # Repeatable, one per input tensor, in the model's own order.
                --input)
                    [ -r "$2" ] || die "cannot read $2"
                    inputs="$inputs\"$(cd "$(dirname "$2")" && pwd)/$(basename "$2")\","
                    shift 2 ;;
                # Runs the CPU reference in the same request, so the ratio
                # comes from one thermal state rather than two steps apart.
                --baseline) baseline=1; shift ;;
                --output-dir)
                    mkdir -p "$2" || die "cannot create $2"
                    output_dir="$(cd "$2" && pwd)"
                    shift 2 ;;
                --iterations) iterations="$2"; shift 2 ;;
                --size) size="$2"; shift 2 ;;
                --channels) channels="$2"; shift 2 ;;
                --filters) filters="$2"; shift 2 ;;
                *) die "unknown option: $1" ;;
            esac
        done
        body="{"
        [ -n "$model" ] && body="$body\"path\":\"$model\","
        [ -n "$inputs" ] && body="$body\"inputs\":[${inputs%,}],"
        [ -n "$output_dir" ] && body="$body\"outputDir\":\"$output_dir\","
        [ -n "$baseline" ] && body="$body\"baseline\":true,"
        [ -n "$device" ] && body="$body\"device\":\"$device\","
        [ -n "$iterations" ] && body="$body\"iterations\":$iterations,"
        [ -n "$size" ] && body="$body\"size\":$size,"
        [ -n "$channels" ] && body="$body\"channels\":$channels,"
        [ -n "$filters" ] && body="$body\"filters\":$filters,"
        body="${body%,}}"
        response="$(case "$kind" in
            add) api POST /v1/tests/nnapi "$body" ;;
            conv) api POST /v1/tests/conv "$body" ;;
            model) api POST /v1/tests/model "$body" ;;
            *) die "unknown test: $kind (expected add, conv or model)" ;;
        esac)"
        printf '%s\n' "$response"
        # A test the device refused is a failed test. curl succeeded, so
        # without this the step passes while the phone is saying it could not
        # run the thing being asked about -- which is exactly how a refusal
        # ends up read as a result (issue #82).
        [ "$(json_field "$response" ok)" = "true" ] || exit 1
        ;;

    bench-all)
        iterations=50; size=64
        while [ $# -gt 0 ]; do
            case "$1" in
                --iterations) iterations="$2"; shift 2 ;;
                --size) size="$2"; shift 2 ;;
                *) die "unknown option: $1" ;;
            esac
        done
        printf '%-22s %12s %10s %s\n' DEVICE AVG_US GFLOPS NOTE
        for dev in $(device_names); do
            result="$(api POST /v1/tests/conv \
                "{\"device\":\"$dev\",\"iterations\":$iterations,\"size\":$size}" || true)"
            if printf '%s' "$result" | grep -q '"ok":true'; then
                printf '%-22s %12s %10s\n' "$dev" \
                    "$(json_field "$result" avgUs)" "$(json_field "$result" gflops)"
            else
                printf '%-22s %12s %10s %s\n' "$dev" "-" \
                    "$(json_field "$result" error)" "$(json_field "$result" result)"
            fi
        done
        ;;

    *)
        die "unknown command: $cmd"
        ;;
esac
